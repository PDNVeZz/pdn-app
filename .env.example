# Copia este archivo a ".env" (en la raíz del backend) y rellena los valores reales.
# NUNCA subas el archivo ".env" a GitHub (ya está en .gitignore).

# console.anthropic.com — usado para identificar el producto a partir de la foto
ANTHROPIC_API_KEY=

# apify.com -> Settings -> Integrations -> API tokens
APIFY_TOKEN=

# apify.com -> Actors -> abre cada actor, el ID aparece como "usuario/nombre-actor"
APIFY_ACTOR_FALABELLA=
APIFY_ACTOR_RIPLEY=
APIFY_ACTOR_PARIS=
APIFY_ACTOR_AHUMADA=

# Puerto local para desarrollo (Railway asigna el suyo propio en producción)
PORT=8000
